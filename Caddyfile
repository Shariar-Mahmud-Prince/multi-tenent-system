{
    admin off
    on_demand_tls {
        ask http://app:8080/api/v1/domains/validate
    }
}

:443 {
    tls {
        on_demand
        issuer internal
    }

    reverse_proxy app:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
    }
}

:80 {
    reverse_proxy app:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto http
    }
}
