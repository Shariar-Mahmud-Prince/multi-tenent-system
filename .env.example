# Server Configuration
SERVER_PORT=8080
ENV=development
BASE_DOMAIN=yourplatform.local

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@postgres:5432/tenant_domains?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Caddy Reverse Proxy & TLS
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
